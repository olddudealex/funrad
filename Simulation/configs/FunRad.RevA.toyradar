{
  "schema_version": 1,
  "design": {
    "name": "FunRad",
    "revision": "Rev.A",
    "description": "Executable working configuration for the 5.8 GHz FunRad FMCW radar"
  },
  "environment": {
    "reference_temperature_k": 290.0,
    "rf_impedance_ohm": 50.0
  },
  "analyses": {
    "snr_min_db": 10.0,
    "adc_quantization_status": "open",
    "fft_scaling_status": "open"
  },
  "scenarios": [
    {
      "id": "close_0dbsm",
      "label": "Close target, 0 dBsm",
      "overrides": {
        "target": {
          "distance_m": 1.0,
          "rcs_dbsm": 0.0
        },
        "tx_attenuator": {
          "attenuation_db": 33.0
        }
      }
    },
    {
      "id": "close_minus10dbsm",
      "label": "Close target, -10 dBsm",
      "overrides": {
        "target": {
          "distance_m": 1.0,
          "rcs_dbsm": -10.0
        },
        "tx_attenuator": {
          "attenuation_db": 33.0
        }
      }
    },
    {
      "id": "far_0dbsm",
      "label": "Far target, 0 dBsm",
      "overrides": {
        "target": {
          "distance_m": 45.0,
          "rcs_dbsm": 0.0
        },
        "tx_attenuator": {
          "attenuation_db": 16.0
        }
      }
    },
    {
      "id": "far_plus10dbsm",
